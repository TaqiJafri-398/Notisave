<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="18dp" android:height="18dp" />
                    <solid android:color="?attr/textPrimary" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_check_inverted"
                android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="18dp" android:height="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="?attr/outlineStrong" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
